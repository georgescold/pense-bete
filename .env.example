DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TIMEZONE=Europe/Paris
LOG_LEVEL=info

# --- Essort : tableau de 6h lu dans le CRM (crm.essort.agency, lecture seule) ---
# Secret de la route /api/pense-bete/agenda du CRM : la valeur de PENSE_BETE_SECRET (Vercel essort-crm).
CRM_SECRET=
# Autre adresse du CRM (un serveur local, par exemple) ; sans elle : https://crm.essort.agency
# CRM_URL=http://127.0.0.1:3199
# Synchro avec le CRM (défaut : toutes les 5 minutes).
ESSORT_SYNC_CRON=*/5 * * * *
ESSORT_LOYS_CHANNEL_ID=
ESSORT_LOYS_USER_ID=
ESSORT_ENZO_CHANNEL_ID=
ESSORT_ENZO_USER_ID=

# --- Essort : l'agenda Google suit les rendez-vous à heure fixe (vide : désactivé) ---
GOOGLE_CALENDAR_ID=
# Clé JSON du compte de service avec qui l'agenda est partagé (brute ou base64).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
