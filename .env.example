DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TIMEZONE=Europe/Paris
LOG_LEVEL=info

# --- Essort : tableau de 6h lu dans le CRM Airtable (lecture seule) ---
# Personal Access Token Airtable, scope data.records:read uniquement, accès à la base Essort.
AIRTABLE_TOKEN=
# Synchro avec le CRM (défaut : toutes les 5 minutes).
ESSORT_SYNC_CRON=*/5 * * * *
ESSORT_LOYS_CHANNEL_ID=
ESSORT_LOYS_USER_ID=
ESSORT_ENZO_CHANNEL_ID=
ESSORT_ENZO_USER_ID=

# --- Essort : l'agenda Google suit les rendez-vous à heure fixe (vide : désactivé) ---
GOOGLE_CALENDAR_ID=
# Clé JSON du compte de service avec qui l'agenda est partagé (brute ou base64).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
